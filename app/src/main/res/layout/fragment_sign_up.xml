<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/cus_login_signup_frame"
    android:padding="16dp"
    tools:context=".Fragment.SignUpFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Sign Up"
        android:layout_marginBottom="20dp"
        android:textColor="#FFFFFF"
        style="@style/custxtOpenSansromanbold20"
        android:textSize="36dp"
        android:gravity="center"/>
    <EditText
        android:id="@+id/cus_login_email"
        android:layout_width="300dp"
        android:layout_height="40dp"
        android:hint="Email"
        android:paddingHorizontal="20dp"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:textColorHint="#000000"
        android:textColor="#000000"
        android:layout_marginTop="20dp"
        android:background="@drawable/cus_splash_buttons" />
    <TextView
        android:id="@+id/cus_login_email_exception"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/red_A700"
        android:textSize="16dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:gravity="center"/>
    <LinearLayout
        android:id="@+id/cus_login_password_frame"
        android:layout_width="300dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_below="@id/cus_login_email"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/cus_splash_buttons">

        <EditText
            android:id="@+id/cus_login_password"
            android:layout_width="260dp"
            android:layout_height="40dp"
            android:hint="Password"
            style="@style/NoUnderlineEditTextStyle"
            android:paddingHorizontal="20dp"
            android:gravity="center_vertical"
            android:textColorHint="#000000"
            android:textColor="#000000" />

        <ImageView
            android:id="@+id/cusimgPasswordVisibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/visibility"
            android:layout_gravity="center"
            android:contentDescription="Toggle Password Visibility"
            android:clickable="true"
            android:layout_alignParentEnd="true"/>
    </LinearLayout>
    <TextView
        android:id="@+id/cus_login_password_exception"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/red_A700"
        android:textSize="16dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:gravity="center"/>
    <LinearLayout
        android:id="@+id/cus_login_confirm_password_frame"
        android:layout_width="300dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_below="@id/cus_login_password_frame"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/cus_splash_buttons">

        <EditText
            android:id="@+id/cus_login_confirm_password"
            android:layout_width="260dp"
            android:layout_height="40dp"
            android:hint="Re-enter Password"
            style="@style/NoUnderlineEditTextStyle"
            android:paddingHorizontal="20dp"
            android:gravity="center_vertical"
            android:textColorHint="#000000"
            android:textColor="#000000" />

        <ImageView
            android:id="@+id/cusimgConfirmPasswordVisibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/visibility"
            android:layout_gravity="center"
            android:contentDescription="Toggle Password Visibility"
            android:clickable="true"
            android:layout_alignParentEnd="true"/>
    </LinearLayout>
    <TextView
        android:id="@+id/cus_passwords_not_match"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center_horizontal"
        android:text="Passwords not match"
        android:textColor="@color/red_A700"
        android:textSize="16dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:gravity="center"/>

    <Button
        android:id="@+id/cus_signup_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Submit"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        android:textColor="#FFFFFF"
        android:background="@drawable/cus_button_update"
        style="@style/custxtOpenSansromanbold20"
        android:textSize="18dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:gravity="center"/>

</LinearLayout>
